model Customer {
  id           Int      @id @default(autoincrement())
  first_name   String
  last_name    String
  email        String   @unique
  phone_number String?
  gst_number   String?
  is_active    Boolean  @default(true)
  is_deleted   Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("customers")
  @@schema("public")
}
