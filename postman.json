{
  "info": {
    "name": "Melden Invoicing and Payments API",
    "description": "Importable Postman collection for the currently active health, customer, invoice, and payment endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5001",
      "type": "string"
    },
    {
      "key": "customer_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "invoice_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            }
          },
          "response": []
        },
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "GET /api/v1/customers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/customers?page=1&limit=10&search=Acme&is_active=true",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "customers"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "Acme" },
                { "key": "is_active", "value": "true" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "POST /api/v1/customers",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Acme\",\n  \"last_name\": \"Corporation\",\n  \"email\": \"accounts@acme.example\",\n  \"phone_number\": \"1234567890\",\n  \"gst_number\": \"29ABCDE1234F1Z5\",\n  \"is_active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/customers",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "customers"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Invoices",
      "item": [
        {
          "name": "POST /api/v1/invoices",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": {{customer_id}},\n  \"invoice_date\": \"2026-10-26\",\n  \"due_date\": \"2026-11-25\",\n  \"line_items\": [\n    {\n      \"description\": \"Consulting service\",\n      \"quantity\": 2,\n      \"unit_price\": 100.00,\n      \"tax_rate\": 18\n    },\n    {\n      \"description\": \"Travel expense\",\n      \"quantity\": 1,\n      \"unit_price\": 50.00,\n      \"tax_rate\": 5\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/invoices",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "invoices"]
            }
          },
          "response": []
        },
        {
          "name": "GET /api/v1/invoices",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/invoices?page=1&limit=10&status=ISSUED&customer_id={{customer_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "invoices"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "ISSUED" },
                { "key": "customer_id", "value": "{{customer_id}}" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET /api/v1/invoices/:id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/invoices/{{invoice_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "invoices", "{{invoice_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "POST /api/v1/invoices/:id/issue",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/invoices/{{invoice_id}}/issue",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "invoices", "{{invoice_id}}", "issue"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "POST /api/v1/payments",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoice_id\": {{invoice_id}},\n  \"customer_id\": {{customer_id}},\n  \"payment_date\": \"2026-10-26\",\n  \"amount\": 100.00,\n  \"payment_method\": \"UPI\",\n  \"reference_number\": \"UPI-REF-001\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/payments",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "payments"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
